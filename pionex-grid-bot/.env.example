# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

PIONEX_API_KEY=your_api_key_here
PIONEX_API_SECRET=your_api_secret_here

# Trading pair (base_quote)
SYMBOL=BTC_USDT

# Grid range
GRID_LOWER=25000
GRID_UPPER=35000
GRID_COUNT=10

# Total USDT to invest across the grid
INVESTMENT=1000

# Order type: LIMIT or MARKET
ORDER_TYPE=LIMIT

# Seconds between bot cycles
LOOP_INTERVAL=30
